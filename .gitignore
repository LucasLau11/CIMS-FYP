# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets / environment files — never commit
.env
.env.*
!.env.example
supabase/.env
supabase/.temp/
nlp_service/.env

# Android release signing material — never commit
/android/key.properties
*.jks
*.keystore

# nlp_service (Python)
nlp_service/.venv/
nlp_service/__pycache__/
nlp_service/**/__pycache__/
# regenerable training artefacts (rebuild with train/prepare_data.py)
nlp_service/train/*.spacy
nlp_service/models/*/model-last/
nlp_service/models/skill_ner_v1/
nlp_service/eval/predictions_*.json
nlp_service/.venv-tf/

# Subagent-driven-development scratch workspace (ledgers, briefs, reports)
.superpowers/
